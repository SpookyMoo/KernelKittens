{
  "name": "kernel-kittens-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e/site.spec.ts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test": "npm run check && npm run test:unit && npm run build && npm run release:gate && npm run test:e2e && npm run test:a11y",
    "release:gate": "node scripts/check-publication-boundary.mjs",
    "deploy:azure": "npx --yes --package @azure/static-web-apps-cli@2.0.10 swa deploy ./dist --env production --yes"
  },
  "dependencies": {
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
