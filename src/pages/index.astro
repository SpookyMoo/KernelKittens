---
import MotionStage from "../components/MotionStage.astro";
import ResultScorecard from "../components/ResultScorecard.astro";
import { verifiedResults } from "../data/results";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="page-shell">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero__copy">
        <p class="eyebrow">Kernel Kittens / CTF team</p>
        <h1 id="home-title">We play CTFs. The scoreboard can do the talking.</h1>
        <p class="lede">Results, write-ups, and whatever survived the packet capture.</p>
        <div class="button-row">
          <a class="button-link" href="/results/">See the results</a>
          <a class="button-link button-link--quiet" href="/writeups/">Read the write-ups</a>
        </div>
      </div>

      <MotionStage
        title="Kernel Kittens motion graphics static keyframe"
        caption="Reserved for the team opener. The poster holds the frame until the motion cut is ready."
      />
    </section>

    <section class="section" aria-labelledby="featured-result-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected result</p>
          <h2 id="featured-result-title">On the board.</h2>
        </div>
        <p>Every number on this page has a source. Work from an older team keeps the older team name.</p>
      </div>

      <div class="home-results">
        {verifiedResults.map((result, index) => (
          <ResultScorecard result={result} featured={index === 0} />
        ))}
      </div>
    </section>

    <section class="section archive-callout" aria-labelledby="archive-title">
      <div>
        <p class="eyebrow">Write-ups</p>
        <h2 id="archive-title">The useful part comes next.</h2>
      </div>
      <div class="archive-callout__copy">
        <p>BushBash notes stay private while publication is blocked. When the rules clear them, the archive gets the real technical work.</p>
        <a href="/writeups/">Open the archive</a>
      </div>
    </section>
  </div>
</BaseLayout>
