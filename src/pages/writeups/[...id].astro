---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicWriteup } from "../../lib/publication";

export async function getStaticPaths() {
  const entries = (await getCollection("writeups")).filter((entry) =>
    isPublicWriteup(entry.data)
  );

  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"writeups">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateLabel = entry.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric"
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  canonicalPath={`/writeups/${entry.id}/`}
>
  <article class="page-shell writeup">
    <header class="page-intro writeup__header">
      <p class="eyebrow">{entry.data.event} / {entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <dl class="writeup__facts">
        <div><dt>Difficulty</dt><dd>{entry.data.difficulty}</dd></div>
        <div><dt>Published</dt><dd><time datetime={entry.data.publishedAt.toISOString()}>{dateLabel}</time></dd></div>
        <div><dt>Authors</dt><dd>{entry.data.authors.join(", ")}</dd></div>
      </dl>
    </header>
    <div class="prose writeup__body">
      <Content />
      <aside class="publication-note" aria-label="Publication basis">
        <strong>Publication basis</strong>
        <p>{entry.data.publicationBasis}</p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .writeup__header {
    max-width: 58rem;
  }

  .writeup__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2.5rem 0 0;
  }

  .writeup__facts div {
    padding-top: 0.8rem;
    border-top: 2px solid var(--line);
  }

  dt {
    color: var(--ink-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  dd {
    margin: 0.3rem 0 0;
    font-weight: 700;
  }

  .publication-note {
    margin-top: 3rem;
    padding: 1.25rem;
    border-left: 0.4rem solid var(--cobalt);
    background: var(--surface);
  }

  .publication-note p {
    margin-bottom: 0;
  }

  @media (max-width: 42rem) {
    .writeup__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
