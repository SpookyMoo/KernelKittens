---
import { getCollection } from "astro:content";
import WriteupCard from "../../components/WriteupCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicWriteup } from "../../lib/publication";

const writeups = (await getCollection("writeups"))
  .filter((entry) => isPublicWriteup(entry.data))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title="Write-ups"
  description="Publication-safe CTF write-ups from Kernel Kittens."
  canonicalPath="/writeups/"
>
  <div class="page-shell">
    <header class="archive-intro">
      <p class="path-label">/writeups/</p>
      <h1>writeups</h1>
      <p class="lede">Public writeups go here when event rules allow them.</p>
    </header>

    <section class="archive-section" aria-labelledby="public-files-title">
      <h2 id="public-files-title">public files</h2>
      <p class="file-count" data-public-file-count>{writeups.length} public files</p>
      {writeups.length > 0 ? (
        <div class="writeup-list">
          {writeups.map((entry) => <WriteupCard entry={entry} />)}
        </div>
      ) : (
        <div class="empty-state">
          <p>Seven confirmed BushBash notes remain private until publication is allowed.</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
