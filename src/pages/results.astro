---
import MotionStage from "../components/MotionStage.astro";
import ResultScorecard from "../components/ResultScorecard.astro";
import { verifiedResults } from "../data/results";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Results"
  description="Verified CTF competition results connected to Kernel Kittens."
  canonicalPath="/results/"
>
  <div class="page-shell">
    <header class="page-intro page-intro--results">
      <p class="eyebrow">Scoreboard</p>
      <h1>Results</h1>
      <p class="lede">Placements we can prove. Prior-team work stays labeled as prior-team work.</p>
    </header>

    <div class="results-layout">
      <section class="result-list" aria-label="Verified competition results">
        {verifiedResults.map((result) => <ResultScorecard result={result} />)}
      </section>

      <aside class="results-cutdown" aria-label="Motion graphics cutdown">
        <MotionStage
          variant="square"
          title="Kernel Kittens square motion graphics static keyframe"
          caption="Square cutdown reserved for result reels and team posts."
        />
      </aside>
    </div>
  </div>
</BaseLayout>
