---
import BaseLayout from "../layouts/BaseLayout.astro";
import { verifiedResults } from "../data/results";
---

<BaseLayout
  title="Results"
  description="Verified CTF competition results connected to Kernel Kittens."
  canonicalPath="/results/"
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Scoreboard</p>
      <h1>Results</h1>
      <p class="lede">Placements we can prove. Prior-team work stays labeled as prior-team work.</p>
    </header>

    <section class="section" aria-label="Verified competition results">
      <div class="result-list">
        {verifiedResults.map((result) => (
          <article class="result-record">
            <p class="status-label">{result.attribution}</p>
            <h2>{result.event} {result.year}</h2>
            <dl>
              <div>
                <dt>Placement</dt>
                <dd>{result.placement} / {result.fieldSize.toLocaleString("en-US")}</dd>
              </div>
              <div>
                <dt>Solved</dt>
                <dd>{result.solved} / {result.totalChallenges}</dd>
              </div>
              <div>
                <dt>Score</dt>
                <dd>{result.score.toLocaleString("en-US")}</dd>
              </div>
            </dl>
            <p>Credited to <strong>{result.creditedTeam}</strong>.</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .result-list {
    display: grid;
    gap: 1rem;
  }

  .result-record {
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .result-record dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .result-record dt {
    color: var(--ink-muted);
  }

  .result-record dd {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 850;
  }

  @media (max-width: 36rem) {
    .result-record dl {
      grid-template-columns: 1fr;
    }
  }
</style>
