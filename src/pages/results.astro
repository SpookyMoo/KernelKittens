---
import ResultLedger from "../components/ResultLedger.astro";
import { verifiedResults } from "../data/results";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Results"
  description="Verified CTF competition results connected to Kernel Kittens."
  canonicalPath="/results/"
>
  <div class="page-shell">
    <header class="archive-intro">
      <p class="path-label">/results/</p>
      <h1>results</h1>
      <p class="lede">Placements we can prove. Prior-team work keeps the prior team name.</p>
    </header>

    <section class="archive-section" aria-labelledby="verified-results-title">
      <h2 id="verified-results-title">verified records</h2>
      <ResultLedger results={verifiedResults} caption="Verified competition results" />
    </section>
  </div>
</BaseLayout>
