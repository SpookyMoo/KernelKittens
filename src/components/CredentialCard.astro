---
import type { Credential } from "../data/credentials";

interface Props {
  credential: Credential;
}

const { credential } = Astro.props;
---

<article class:list={["credential-card", `credential-card--${credential.kind}`]}>
  <div class="credential-card__topline">
    <span class="status-label">{credential.statusLabel}</span>
    <span class="credential-card__id" aria-hidden="true">{credential.id.slice(0, 2).toUpperCase()}</span>
  </div>
  <h3>{credential.title}</h3>
  <p class="credential-card__issuer">{credential.issuer}</p>
  <p>{credential.context}</p>
</article>

<style>
  .credential-card {
    min-height: 16.5rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 0 8px 30px rgb(16 29 45 / 5%);
  }

  .credential-card--current {
    border-top: 0.42rem solid var(--cobalt);
  }

  .credential-card--expired {
    border-top: 0.42rem solid var(--solder);
  }

  .credential-card--result {
    border-top: 0.42rem solid var(--signal);
  }

  .credential-card__topline {
    display: flex;
    min-height: 2rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .credential-card__id {
    color: var(--ink-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
    font-weight: 800;
  }

  h3 {
    margin-top: 1.6rem;
  }

  p {
    color: var(--ink-muted);
  }

  .credential-card__issuer {
    margin: 0.55rem 0 1.2rem;
    color: var(--ink);
    font-weight: 750;
  }
</style>
