---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"writeups">;
}

const { entry } = Astro.props;
const dateLabel = entry.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---

<article class="writeup-card">
  <div class="writeup-card__meta">
    <span>{entry.data.event}</span>
    <span>{entry.data.category}</span>
    <span>{entry.data.difficulty}</span>
  </div>
  <h2><a href={`/writeups/${entry.id}/`}>{entry.data.title}</a></h2>
  <p>{entry.data.summary}</p>
  <time datetime={entry.data.publishedAt.toISOString()}>{dateLabel}</time>
</article>

<style>
  .writeup-card {
    padding: clamp(1.4rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .writeup-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    color: var(--cobalt-deep);
    font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 1.1rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  h2 a {
    color: var(--ink);
  }

  p {
    color: var(--ink-muted);
  }

  time {
    color: var(--ink-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
  }
</style>
