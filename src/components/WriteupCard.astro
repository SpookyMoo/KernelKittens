---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"writeups">;
}

const { entry } = Astro.props;
const dateLabel = entry.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});
---

<article class="writeup-entry">
  <time datetime={entry.data.publishedAt.toISOString()}>{dateLabel}</time>
  <div>
    <h2><a href={`/writeups/${entry.id}/`}>/writeups/{entry.id}/</a></h2>
    <p>{entry.data.title} / {entry.data.event} / {entry.data.category} / {entry.data.difficulty}</p>
    <p>{entry.data.summary}</p>
  </div>
</article>
