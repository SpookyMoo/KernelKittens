---
import { siteConfig } from "../config/site";

const currentPath = Astro.url.pathname;
const asciiCat = String.raw` /\_/\
( o.o )
 > ^ <`;
const links = [
  { href: "/", label: "home" },
  { href: "/results/", label: "results" },
  { href: "/writeups/", label: "write-ups" }
];

function isCurrent(href: string): boolean {
  if (href === "/") return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="crew-identity" href="/" aria-label={siteConfig.name}>
      <pre class="crew-cat" aria-hidden="true">{asciiCat}</pre>
      <span class="crew-signature" data-crew-signature>
        <strong>kernel kittens</strong>
        <small>root@kk / est. 2026</small>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="crew-nav">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              [{link.label}]
            </a>
          </li>
        ))}
        {siteConfig.ctfTimeUrl && <li><a href={siteConfig.ctfTimeUrl}>[ctftime]</a></li>}
      </ul>
    </nav>
  </div>
</header>
