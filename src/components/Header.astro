---
import BrandMark from "./BrandMark.astro";
import { siteConfig } from "../config/site";

const currentPath = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/results/", label: "Results" },
  { href: "/writeups/", label: "Write-ups" }
];

function isCurrent(href: string): boolean {
  if (href === "/") return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand-link" href="/" aria-label="Kernel Kittens">
      <BrandMark decorative={true} class="brand-link__mark" />
      <span class="brand-link__name">Kernel Kittens</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        {siteConfig.ctfTimeUrl && (
          <li><a href={siteConfig.ctfTimeUrl}>CTFtime</a></li>
        )}
      </ul>
    </nav>
  </div>
</header>
