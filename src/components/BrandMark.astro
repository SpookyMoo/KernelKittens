---
interface Props {
  decorative?: boolean;
  class?: string;
}

const { decorative = false, class: className = "" } = Astro.props;
---

<svg
  class:list={["brand-mark", className]}
  viewBox="0 0 160 160"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-labelledby={decorative ? undefined : "brand-mark-title"}
  focusable="false"
>
  {!decorative && <title id="brand-mark-title">Kernel Kittens cat processor mark</title>}
  <path class="mark-fill" d="M39 48 54 24l18 20h16l18-20 15 24v62a18 18 0 0 1-18 18H57a18 18 0 0 1-18-18Z" />
  <path class="mark-line" d="M39 48 54 24l18 20h16l18-20 15 24v62a18 18 0 0 1-18 18H57a18 18 0 0 1-18-18Z" />
  <path class="mark-line" d="M61 73h12m14 0h12M66 94l14 8 14-8" />
  <path class="mark-trace" d="M39 72H17l-7-7M39 87H12M39 102H17l-7 7M121 72h22l7-7M121 87h27M121 102h22l7 7" />
  <rect class="mark-cursor" x="74" y="78" width="12" height="12" rx="2" />
  <circle class="mark-node" cx="10" cy="65" r="4" />
  <circle class="mark-node" cx="12" cy="87" r="4" />
  <circle class="mark-node" cx="10" cy="109" r="4" />
  <circle class="mark-node" cx="150" cy="65" r="4" />
  <circle class="mark-node" cx="148" cy="87" r="4" />
  <circle class="mark-node" cx="150" cy="109" r="4" />
</svg>

<style>
  .brand-mark {
    display: block;
    overflow: visible;
  }

  .mark-fill {
    fill: var(--surface);
  }

  .mark-line,
  .mark-trace {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: square;
    stroke-linejoin: round;
    stroke-width: 7;
  }

  .mark-trace {
    stroke: var(--cobalt);
    stroke-width: 5;
  }

  .mark-cursor {
    fill: var(--signal);
  }

  .mark-node {
    fill: var(--cobalt);
  }
</style>
