---
import BrandMark from "./BrandMark.astro";

interface Props {
  variant?: "wide" | "square";
  title: string;
  caption: string;
}

const { variant = "wide", title, caption } = Astro.props;
---

<figure class:list={["motion-stage", `motion-stage--${variant}`]} aria-label={title}>
  <div class="motion-stage__plate" aria-hidden="true">
    <div class="motion-stage__topline">
      <span>KK MOTION PLATE</span>
      <span>{variant === "wide" ? "16:9" : "1:1"} / F001</span>
    </div>

    <div class="motion-stage__frame">
      <span class="motion-stage__word motion-stage__word--top">KERNEL</span>
      <BrandMark decorative={true} class="motion-stage__mark" />
      <span class="motion-stage__word motion-stage__word--bottom">KITTENS</span>
      <span class="motion-stage__crosshair motion-stage__crosshair--one"></span>
      <span class="motion-stage__crosshair motion-stage__crosshair--two"></span>
    </div>

    <div class="motion-stage__timeline">
      <span class="motion-stage__playhead"></span>
      <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>

  <figcaption>
    <span>Static keyframe</span>
    {caption}
  </figcaption>
</figure>
