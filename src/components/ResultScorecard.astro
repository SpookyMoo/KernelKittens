---
import type { VerifiedCompetitionResult } from "../data/results";

interface Props {
  result: VerifiedCompetitionResult;
  featured?: boolean;
}

const { result, featured = false } = Astro.props;
---

<article
  class:list={["result-scorecard", { "result-scorecard--featured": featured }]}
  data-result-status={result.status}
>
  <header class="result-scorecard__header">
    <p class="result-scorecard__event-code">KK / RESULT {result.year}</p>
    <p class="result-scorecard__attribution">{result.attribution}</p>
  </header>

  <div class="result-scorecard__body">
    <div class="result-scorecard__identity">
      <p class="result-scorecard__rank" aria-label={`${result.placementLabel} place`}>
        <span>{result.placement}</span><sup>{result.placementLabel.replace(String(result.placement), "")}</sup>
      </p>
      <div>
        <h2>{result.event} {result.year}</h2>
        <p>Credited to <strong>{result.creditedTeam}</strong></p>
      </div>
    </div>

    <dl class="result-scorecard__metrics">
      <div>
        <dt>Placement</dt>
        <dd>{result.placement} / {result.fieldSize.toLocaleString("en-US")}</dd>
      </div>
      <div>
        <dt>Solved</dt>
        <dd>{result.solved} / {result.totalChallenges}</dd>
      </div>
      <div>
        <dt>Score</dt>
        <dd>{result.score.toLocaleString("en-US")}</dd>
      </div>
    </dl>
  </div>
</article>
